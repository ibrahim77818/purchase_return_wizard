<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_return_log_view_tree" model="ir.ui.view">
        <field name="name">purchase.return.log.tree</field>
        <field name="model">purchase.return.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="date"/>
                <field name="purchase_id"/>
                <field name="origin_picking_id" optional="hide"/>
                <field name="partner_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="routing" widget="badge"
                       decoration-info="routing == 'return_only'"
                       decoration-warning="routing == 'return_credit'"/>
                <field name="refund_id"/>
                <field name="refund_state" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_credited" sum="Total Credited"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="purchase_return_log_view_form" model="ir.ui.view">
        <field name="name">purchase.return.log.form</field>
        <field name="model">purchase.return.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="purchase_id"/>
                            <field name="origin_picking_id"
                                   invisible="not origin_picking_id"/>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="routing"/>
                            <field name="refund_id"/>
                            <field name="refund_state" invisible="not refund_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_credited"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Returned Lines" name="lines">
                            <field name="line_ids">
                                <tree>
                                    <field name="product_id"/>
                                    <field name="scenario" widget="badge"/>
                                    <field name="qty_returned"/>
                                    <field name="product_uom_id" groups="uom.group_uom"/>
                                    <field name="qty_credited"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="amount_credited" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Return Transfers" name="pickings">
                            <field name="return_picking_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="date_done"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Reason" name="note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="purchase_return_log_view_search" model="ir.ui.view">
        <field name="name">purchase.return.log.search</field>
        <field name="model">purchase.return.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="purchase_id"/>
                <field name="origin_picking_id"/>
                <field name="partner_id"/>
                <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter name="with_credit" string="With Credit Note" domain="[('refund_id', '!=', False)]"/>
                <filter name="return_only" string="Return Only" domain="[('routing', '=', 'return_only')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_routing" string="Routing" context="{'group_by': 'routing'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_purchase_return_log" model="ir.actions.act_window">
        <field name="name">Purchase Returns</field>
        <field name="res_model">purchase.return.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No purchase returns yet</p>
            <p>Use the "Return / Refund" button on a confirmed purchase order.</p>
        </field>
    </record>

    <menuitem id="menu_purchase_return_log"
              name="Purchase Returns"
              parent="purchase.menu_procurement_management"
              action="action_purchase_return_log"
              sequence="20"/>
</odoo>
