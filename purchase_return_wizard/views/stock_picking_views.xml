<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_purchase_return_wizard" model="ir.ui.view">
        <field name="name">stock.picking.form.purchase.return.wizard</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- placed right after Odoo's own "Return" button -->
            <xpath expr="//header/button[@name='%(stock.act_stock_return_picking)d']" position="after">
                <field name="prw_can_return" invisible="1"/>
                <button name="action_open_purchase_return_wizard" type="object"
                        string="Return / Refund"
                        groups="purchase_return_wizard.group_purchase_return"
                        attrs="{'invisible': [('prw_can_return', '=', False)]}"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_prw_return_logs" type="object" class="oe_stat_button"
                        icon="fa-undo" groups="purchase.group_purchase_user"
                        attrs="{'invisible': [('prw_return_log_count', '=', 0)]}">
                    <field name="prw_return_log_count" widget="statinfo" string="PO Returns"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
