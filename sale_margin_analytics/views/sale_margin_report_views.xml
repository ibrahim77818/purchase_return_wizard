<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_margin_report_view_pivot" model="ir.ui.view">
        <field name="name">sale.margin.report.view.pivot</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <pivot string="Margin Analysis" sample="1">
                <field name="date" type="row" interval="month"/>
                <field name="team_id" type="col"/>
                <field name="price_subtotal" type="measure"/>
                <field name="cost_total" type="measure"/>
                <field name="margin" type="measure"/>
                <field name="margin_percent" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="sale_margin_report_view_graph" model="ir.ui.view">
        <field name="name">sale.margin.report.view.graph</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <graph string="Margin Analysis" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="margin" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="sale_margin_report_view_tree" model="ir.ui.view">
        <field name="name">sale.margin.report.view.tree</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <tree string="Margin Analysis" create="0" edit="0" delete="0"
                  decoration-danger="margin_percent &lt; 0"
                  decoration-warning="margin_percent &gt;= 0 and margin_percent &lt; 10"
                  decoration-success="margin_percent &gt;= 30">
                <field name="currency_id" invisible="1"/>
                <field name="date" widget="date"/>
                <field name="order_id"/>
                <field name="commercial_partner_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="product_id"/>
                <field name="categ_id" optional="hide"/>
                <field name="qty_ordered" string="Qty"/>
                <field name="line_uom_id" string="UoM" groups="uom.group_uom" optional="show"/>
                <field name="price_unit" optional="show"/>
                <field name="discount" optional="show"/>
                <field name="price_unit_net" optional="hide"/>
                <field name="cost_unit"/>
                <field name="price_subtotal" widget="monetary" sum="Total"/>
                <field name="price_tax" widget="monetary" sum="Total" optional="hide"/>
                <field name="price_total" widget="monetary" sum="Total" optional="hide"/>
                <field name="cost_total" widget="monetary" sum="Total"/>
                <field name="margin" widget="monetary" sum="Total"/>
                <field name="margin_percent"/>
                <field name="qty_delivered" optional="hide"/>
                <field name="delivered_margin" widget="monetary" sum="Total" optional="hide"/>
                <field name="cost_source" optional="hide"/>
                <field name="order_currency_id" optional="hide" groups="base.group_multi_currency"/>
            </tree>
        </field>
    </record>

    <record id="sale_margin_report_view_search" model="ir.ui.view">
        <field name="name">sale.margin.report.view.search</field>
        <field name="model">sale.margin.report</field>
        <field name="arch" type="xml">
            <search string="Margin Analysis">
                <field name="order_id"/>
                <field name="commercial_partner_id"/>
                <field name="product_id"/>
                <field name="categ_id" operator="child_of"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <filter name="confirmed" string="Sales Orders"
                        domain="[('state', 'in', ('sale', 'done'))]"/>
                <filter name="quotations" string="Quotations"
                        domain="[('state', 'in', ('draft', 'sent'))]"/>
                <separator/>
                <filter name="filter_date" string="Order Date" date="date"/>
                <separator/>
                <filter name="margin_negative" string="Loss-Making (&lt; 0%)"
                        domain="[('margin_percent', '&lt;', 0)]"/>
                <filter name="margin_low" string="Low Margin (0–10%)"
                        domain="[('margin_percent', '&gt;=', 0), ('margin_percent', '&lt;', 10)]"/>
                <filter name="margin_mid" string="Standard Margin (10–30%)"
                        domain="[('margin_percent', '&gt;=', 10), ('margin_percent', '&lt;', 30)]"/>
                <filter name="margin_high" string="High Margin (≥ 30%)"
                        domain="[('margin_percent', '&gt;=', 30)]"/>
                <separator/>
                <filter name="discounted" string="Discounted Lines"
                        domain="[('discount', '&gt;', 0)]"/>
                <filter name="actual_cost" string="Actual Cost (Valuation)"
                        domain="[('cost_source', 'in', ('actual', 'mixed'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer"
                            context="{'group_by': 'commercial_partner_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                    <filter name="group_categ" string="Product Category" context="{'group_by': 'categ_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_order" string="Sales Order" context="{'group_by': 'order_id'}"/>
                    <filter name="group_cost_source" string="Cost Basis" context="{'group_by': 'cost_source'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                    <separator/>
                    <filter name="group_date" string="Order Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_margin_report" model="ir.actions.act_window">
        <field name="name">Margin Analysis</field>
        <field name="res_model">sale.margin.report</field>
        <field name="view_mode">pivot,graph,tree</field>
        <field name="search_view_id" ref="sale_margin_report_view_search"/>
        <field name="context">{'search_default_confirmed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No margin data yet</p>
            <p>Confirm sales orders to analyse revenue, cost and margin by customer,
                team, salesperson, category or product. Margin % is weighted by revenue
                in every pivot cell.</p>
        </field>
    </record>
</odoo>
